export global NavSearch {
    in-out property <string> query;
    // Collapsed group names, each wrapped in `|` (e.g. "|Security|Generators|"); kept in sync with the config by Rust.
    in-out property <string> collapsed;
    callback toggle-group(string);
    pure callback is-collapsed(string, string) -> bool;
    // True when every word of the query occurs in the haystack (implemented in Rust, Slint has no `contains`).
    pure callback matches(string, string) -> bool;
}
