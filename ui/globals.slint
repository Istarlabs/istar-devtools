export global VectorCalculatorState {
    in-out property <VectorInput> vector-a: { x: "1", y: "0", z: "0" };
    in-out property <VectorInput> vector-b: { x: "0", y: "1", z: "0" };
    in-out property <string> scalar-input: "2";
    in-out property <float> lerp-t: 0.5;
    in-out property <string> lerp-t-display: "0.50";
    in-out property <int> operation-index: 0;
    in-out property <int> view-plane-index: 0;
    in-out property <VectorResult> result;
    in-out property <bool> shows-result-vector: false;
    // canvas-points layout (26 floats):
    //  0-5:  A tip + arrowhead p1/p2
    //  6-11: B tip + arrowhead p1/p2
    // 12-17: Result tip + arrowhead p1/p2
    // 18-19: extra point (lerp dot, etc.)
    // 20-25: reserved extras
    in-out property <[float]> canvas-points: [
        225, 200, 225, 200, 225, 200,
        225, 200, 225, 200, 225, 200,
        225, 200, 225, 200, 225, 200,
        0, 0, 0, 0, 0, 0, 0, 0
    ];
    callback calculate();
    callback copy-result();
    callback swap-vectors();
    callback view-plane-changed(int);
}

