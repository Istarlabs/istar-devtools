export global SystemdState {
    in-out property <int>    tab: 0;  // 0=Container 1=Volume 2=Network 3=Pod 4=Timer 5=Backup
    // Container
    in-out property <string> container-name;
    in-out property <string> container-description;
    in-out property <string> container-image;
    in-out property <string> container-ports;
    in-out property <string> container-volumes;
    in-out property <string> container-environment;
    in-out property <string> container-network;
    in-out property <bool>   container-auto-update: true;
    in-out property <int>    container-restart-index: 0;  // 0=always 1=on-failure 2=no
    in-out property <bool>   container-start-on-boot: true;
    // Volume
    in-out property <string> volume-name;
    in-out property <string> volume-driver;
    in-out property <string> volume-labels;
    // Network
    in-out property <string> network-name;
    in-out property <string> network-driver;
    in-out property <string> network-subnet;
    in-out property <string> network-gateway;
    in-out property <bool>   network-ipv6;
    in-out property <bool>   network-internal;
    // Pod
    in-out property <string> pod-name;
    in-out property <string> pod-ports;
    in-out property <string> pod-network;
    in-out property <bool>   pod-start-on-boot;
    // Timer
    in-out property <string> timer-name;
    in-out property <string> timer-description;
    in-out property <string> timer-command;
    in-out property <string> timer-working-directory;
    in-out property <int>    timer-schedule-index: 1;  // 0=hourly 1=daily 2=weekly 3=monthly 4=custom
    in-out property <string> timer-calendar;
    in-out property <bool>   timer-persistent: true;
    in-out property <string> timer-delay;
    in-out property <bool>   timer-enable-now: true;
    // Backup
    in-out property <string> backup-name;
    in-out property <int>    backup-source-index: 0;  // 0=directory 1=Podman volume
    in-out property <string> backup-source;
    in-out property <string> backup-target;
    in-out property <int>    backup-compression-index: 1;  // 0=gz 1=zst 2=xz
    in-out property <string> backup-keep-days: "14";
    in-out property <int>    backup-schedule-index: 1;  // 0=hourly 1=daily 2=weekly 3=monthly 4=custom
    in-out property <string> backup-calendar;
    in-out property <bool>   backup-enable-now: true;
    // Result
    in-out property <string> output;
    in-out property <string> file-name;
    in-out property <string> secondary-output;
    in-out property <string> secondary-file-name;
    in-out property <bool>   show-secondary;
    in-out property <string> error;
    in-out property <string> status;
    in-out property <bool>   status-is-error;
    callback generate();
    callback copy-output();
    callback save-output();
    callback install-output();
}

