export global JwtState {
    in-out property <bool> encode-mode: false;
    // Decode
    in-out property <string> token-input;
    in-out property <string> header-json;
    in-out property <string> payload-json;
    in-out property <string> signature-raw;
    in-out property <string> decode-error;
    in-out property <int>    verify-algorithm-index: 0;
    in-out property <string> verify-secret;
    in-out property <int>    verify-status: 0;  // 0=none 1=valid 2=invalid 3=error
    in-out property <string> verify-message;
    // Encode
    in-out property <string> encode-header: "{\n  \"alg\": \"HS256\",\n  \"typ\": \"JWT\"\n}";
    in-out property <string> encode-payload: "{\n  \"sub\": \"1234567890\",\n  \"name\": \"John Doe\"\n}";
    in-out property <int>    encode-algorithm-index: 0;
    in-out property <string> encode-secret;
    in-out property <string> encode-result;
    in-out property <string> encode-error;
    callback decode();
    callback verify();
    callback encode();
    callback copy-result();
    callback paste-token();
}

