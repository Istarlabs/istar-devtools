export global SecurityState {
    in-out property <int>         mode-index: 0;  // 0=HMAC 1=password 2=passphrase
    // HMAC
    in-out property <string>      hmac-message;
    in-out property <string>      hmac-key;
    in-out property <bool>        hmac-key-hex;
    in-out property <int>         hmac-algorithm-index: 2;  // 0=MD5 1=SHA-1 2=SHA-256 3=SHA-512
    // Password
    in-out property <string>      password-length: "20";
    in-out property <bool>        password-lower: true;
    in-out property <bool>        password-upper: true;
    in-out property <bool>        password-digits: true;
    in-out property <bool>        password-symbols: true;
    in-out property <bool>        password-no-look-alikes: true;
    // Passphrase
    in-out property <string>      passphrase-words: "5";
    in-out property <string>      passphrase-separator: "-";
    in-out property <bool>        passphrase-capitalize: true;
    in-out property <bool>        passphrase-digit: true;
    // Shared
    in-out property <string>      count: "5";
    in-out property <[ResultRow]> rows;
    in-out property <string>      note;
    in-out property <string>      error;
    callback generate();
    callback copy(string);
}

