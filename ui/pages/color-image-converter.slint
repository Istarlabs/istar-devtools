import { Button, LineEdit, ComboBox, CheckBox, Slider } from "std-widgets.slint";
import { PageContainer } from "../components/page-container.slint";
import { SeparatorLine } from "../components/separator-line.slint";
import { ColorImageConverterState } from "../globals.slint";
import { Theme } from "../theme.slint";

// One read-only color format row: label, value, copy button.
component ColorRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    callback copy();

    spacing: Theme.space-sm;

    Text {
        text: label;
        vertical-alignment: center;
        min-width: 60px;
        color: Theme.color-muted;
        font-size: Theme.font-sm;
    }

    Text {
        text: value;
        vertical-alignment: center;
        horizontal-stretch: 1;
        font-family: "monospace";
        font-size: Theme.font-sm;
    }

    Button {
        text: @tr("Copy");
        enabled: !value.is-empty;
        clicked => {
            copy();
        }
    }
}

export component ColorImageConverterPage inherits PageContainer {
    title-text: @tr("Color & Image Converter");
    subtitle-text: @tr("Convert color spaces and image formats");

    // Mode tabs
    HorizontalLayout {
        spacing: Theme.space-sm;
        alignment: start;

        Button {
            text: @tr("Color");
            primary: !ColorImageConverterState.image-mode;
            clicked => {
                ColorImageConverterState.image-mode = false;
            }
        }

        Button {
            text: @tr("Image");
            primary: ColorImageConverterState.image-mode;
            clicked => {
                ColorImageConverterState.image-mode = true;
            }
        }
    }

    SeparatorLine { }

    // ---------------- COLOR MODE ----------------
    if !ColorImageConverterState.image-mode: VerticalLayout {
        spacing: Theme.space-md;

        HorizontalLayout {
            spacing: Theme.space-sm;

            Text {
                text: @tr("Input");
                vertical-alignment: center;
                min-width: 60px;
            }

            LineEdit {
                text <=> ColorImageConverterState.color-input;
                placeholder-text: @tr("#1a2b3c, rgb(26,43,60), hsl(…) or a CSS name");
                horizontal-stretch: 1;
                accepted => {
                    ColorImageConverterState.parse-color();
                }
            }

            Button {
                text: @tr("Parse");
                primary: true;
                clicked => {
                    ColorImageConverterState.parse-color();
                }
            }
        }

        if !ColorImageConverterState.color-error.is-empty: Text {
            text: ColorImageConverterState.color-error;
            font-size: Theme.font-sm;
            color: #e05050;
            wrap: word-wrap;
        }

        if ColorImageConverterState.color-valid: Rectangle {
            height: 80px;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.color-subtle;
            background: ColorImageConverterState.color-swatch;
        }

        if ColorImageConverterState.color-valid: VerticalLayout {
            spacing: Theme.space-xs;

            ColorRow {
                label: "HEX";
                value: ColorImageConverterState.color-hex;
                copy => { ColorImageConverterState.copy-color(0); }
            }
            ColorRow {
                label: "RGB";
                value: ColorImageConverterState.color-rgb;
                copy => { ColorImageConverterState.copy-color(1); }
            }
            ColorRow {
                label: "HSL";
                value: ColorImageConverterState.color-hsl;
                copy => { ColorImageConverterState.copy-color(2); }
            }
            ColorRow {
                label: "HSV";
                value: ColorImageConverterState.color-hsv;
                copy => { ColorImageConverterState.copy-color(3); }
            }
            ColorRow {
                label: "CMYK";
                value: ColorImageConverterState.color-cmyk;
                copy => { ColorImageConverterState.copy-color(4); }
            }
            ColorRow {
                label: "CSS";
                value: ColorImageConverterState.color-css-name;
                copy => { ColorImageConverterState.copy-color(5); }
            }
        }
    }

    // ---------------- IMAGE MODE ----------------
    if ColorImageConverterState.image-mode: VerticalLayout {
        spacing: Theme.space-md;

        HorizontalLayout {
            spacing: Theme.space-sm;
            alignment: start;

            Button {
                text: @tr("Open Image");
                clicked => {
                    ColorImageConverterState.open-image();
                }
            }

            Text {
                text: ColorImageConverterState.image-info;
                vertical-alignment: center;
                color: Theme.color-muted;
                font-size: Theme.font-sm;
            }
        }

        HorizontalLayout {
            spacing: Theme.space-sm;

            Text {
                text: @tr("Output format");
                vertical-alignment: center;
                min-width: 110px;
            }

            ComboBox {
                model: ["PNG", "JPEG", "WebP", "BMP"];
                current-index <=> ColorImageConverterState.output-format-index;
            }
        }

        if ColorImageConverterState.output-format-index == 1: HorizontalLayout {
            spacing: Theme.space-sm;

            Text {
                text: @tr("JPEG quality");
                vertical-alignment: center;
                min-width: 110px;
            }

            Slider {
                minimum: 1;
                maximum: 100;
                value: ColorImageConverterState.jpeg-quality;
                horizontal-stretch: 1;
                changed(v) => {
                    ColorImageConverterState.jpeg-quality = Math.round(v);
                }
            }

            Text {
                text: ColorImageConverterState.jpeg-quality;
                vertical-alignment: center;
                min-width: 30px;
            }
        }

        HorizontalLayout {
            spacing: Theme.space-sm;
            alignment: start;

            CheckBox {
                text: @tr("Resize");
                checked <=> ColorImageConverterState.resize-enabled;
            }
        }

        if ColorImageConverterState.resize-enabled: HorizontalLayout {
            spacing: Theme.space-sm;
            alignment: start;

            Text {
                text: @tr("Width");
                vertical-alignment: center;
            }

            LineEdit {
                text <=> ColorImageConverterState.resize-width;
                width: 90px;
                input-type: number;
            }

            Text {
                text: @tr("Height");
                vertical-alignment: center;
            }

            LineEdit {
                text <=> ColorImageConverterState.resize-height;
                width: 90px;
                input-type: number;
            }

            CheckBox {
                text: @tr("Keep ratio");
                checked <=> ColorImageConverterState.keep-aspect-ratio;
            }
        }

        HorizontalLayout {
            alignment: end;

            Button {
                text: @tr("Convert & Save");
                primary: true;
                enabled: ColorImageConverterState.has-image;
                clicked => {
                    ColorImageConverterState.convert-image();
                }
            }
        }

        if !ColorImageConverterState.image-status.is-empty: Text {
            text: ColorImageConverterState.image-status;
            font-size: Theme.font-sm;
            color: Theme.color-muted;
            wrap: word-wrap;
        }
    }
}
